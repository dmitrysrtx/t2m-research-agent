# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# OpenRouter, OpenAI, or local vLLM / Ollama API endpoint
OPENROUTER_API_KEY=your_api_key_here
API_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-3.5-sonnet

# ==============================================================================
# Academic Search & Fetcher Flags
# ==============================================================================
# Default academic search prompt used when none is provided
DEFAULT_SEARCH_QUERY="text-to-motion human motion"

# Maximum papers to retrieve per sub-agent domain (Kinematic, Physics, RL, Pose)
MAX_RESULTS_PER_DOMAIN=5

# Toggle active fetchers (True / False)
ENABLE_IEEE=True
ENABLE_SCHOLAR=True
ENABLE_ARXIV=False
ENABLE_SEMANTIC_SCHOLAR=False

# Master literature review output markdown file in repository root
DEFAULT_OUTPUT_FILE=LITERATURE_REVIEW.md

# ==============================================================================
# Institutional Authentication & EZproxy Configuration
# ==============================================================================
# Supported institutions: afeka | technion | custom
IEEE_INSTITUTION=afeka
EZPROXY_DOMAIN=ezproxy.afeka.ac.il

# Institutional SSO credentials (used for automated 2FA login)
IEEE_USERNAME=your_username@s.afeka.ac.il
IEEE_PASSWORD=your_password_here

# Automatically trigger mobile push 2FA on phone when cookies expire
AUTO_SSO_LOGIN=True

# (Optional) Direct cookie override (paste header or Cookie-Editor JSON)
EZPROXY_COOKIE=
